# Переменные боевого окружения календаря. На сервере лежит рядом с docker-compose.yml как .env,
# в репозиторий НЕ едет (см. .gitignore). Здесь — только образцы значений.

# Откуда брать образы и какой тег разворачиваем (ставит workflow деплоя).
REGISTRY=registry.example.ru/hema
IMAGE_TAG=2026-11-05-1

# База. Пароль — длинный случайный, генерировать на сервере: openssl rand -base64 24
POSTGRES_DB=hema_calendar
POSTGRES_USER=calendar
POSTGRES_PASSWORD=замените-меня
# Порт базы на петле сервера: нужен миграциям и резервной копии, наружу не смотрит.
CALENDAR_PG_PORT=5433

# Ключ модератора: с ним видны контакты заявителей. ТОЛЬКО латиница, цифры и знаки препинания —
# значение заголовка HTTP не принимает кириллицу, браузер падает до отправки запроса.
# Генерировать: openssl rand -hex 24
CALENDAR_ADMIN_KEY=замените-меня
