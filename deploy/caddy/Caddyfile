# Маршрутизация календаря. Одно имя — одна строка: API наружу не публикуется вовсе, запросы
# браузера к /api проводит сам фронт (frontend/app/api/[...path]/route.ts), поэтому второго
# домена вида api.calendar.hema.ru здесь нет и не нужно.
#
# TLS Caddy получает сам (HTTP-01), сертификат — на это имя.
# Контейнер адресуется по container_name из deploy/prod/docker-compose.yml; его порт на хост
# не опубликован, Caddy достаёт его внутри общей docker-сети.

calendar.hema.ru {
	reverse_proxy calendar-frontend:3000

	# X-Forwarded-For Caddy ставит сам; бэкенд читает его (Proxy__Enabled=true), чтобы лимитер
	# заявок считал настоящих посетителей, а не контейнер фронта.

	encode zstd gzip

	log {
		output file /var/log/caddy/calendar.log
		format json
	}
}

# Если календарь живёт на том же сервере, что и портал, этот блок добавляется в общий
# Caddyfile портала, а отдельный Caddy не поднимается: два Caddy за один 443-й порт не делят.
